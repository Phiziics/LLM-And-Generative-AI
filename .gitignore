# Github's default gitignore for Python

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   https://pdm.fming.dev/#use-with-ide
.pdm.toml

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
llms/
llms.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# PyCharm
.idea/

# Added this to ignore models downloaded from HF
model_cache/
# Ignore finder files
.DS_Store
/.DS_Store

# Ignore Chroma vector database
vector_db/
products_vectorstore/

# And ignore any pickle files made during the course
*.pkl

# ignore gradio private files
.gradio
/.gradio

# ignore diagnostics reports
**/report.txt

# ignore optimized C++ code from being checked into repo
week4/optimized
week4/simple
*.env.save
.virtual_documents/
WingIDE_Projekti/
nohup.out
*.png

scraper_cache/
challenge/

# WandB local sync data.
wandb/

week2/**/prices.db
week4/main.cpp
week4/main
week4/main.exe
week4/main.rs

week5/preprocessed_db/
week5/vector_db/


local/

week6/full/
week6/lite/
week6/*/*.pkl
week6/*/*.jsonl
week6/*.pth
week6/*.joblib
week8/*.pth

# BenefitsAI project-specific ignores

# Raw and processed data
rag/benefits_ai_platform/data/01_raw/*
rag/benefits_ai_platform/data/02_preprocessed/*
rag/benefits_ai_platform/data/03_features/*
rag/benefits_ai_platform/data/04_predictions/*

# Keep data folder structure
!rag/benefits_ai_platform/data/01_raw/.gitkeep
!rag/benefits_ai_platform/data/02_preprocessed/.gitkeep
!rag/benefits_ai_platform/data/03_features/.gitkeep
!rag/benefits_ai_platform/data/04_predictions/.gitkeep

# Large model and experiment artifacts
rag/benefits_ai_platform/models/*
rag/benefits_ai_platform/artifacts/*
rag/benefits_ai_platform/mlruns/
rag/benefits_ai_platform/mlartifacts/

# Keep model/artifact folders
!rag/benefits_ai_platform/models/.gitkeep
!rag/benefits_ai_platform/artifacts/.gitkeep

# Vector databases and embedding indexes
rag/benefits_ai_platform/vector_db/
rag/benefits_ai_platform/chroma_db/
rag/benefits_ai_platform/faiss_index/
rag/benefits_ai_platform/*.index

# Secrets and cloud credentials
rag/benefits_ai_platform/.env
rag/benefits_ai_platform/.env.*
!rag/benefits_ai_platform/.env.example
rag/benefits_ai_platform/secrets/
rag/benefits_ai_platform/credentials/
rag/benefits_ai_platform/*service-account*.json
rag/benefits_ai_platform/*google-credentials*.json
rag/benefits_ai_platform/*gcp-credentials*.json
rag/benefits_ai_platform/kaggle.json

# App and API logs
rag/benefits_ai_platform/logs/
rag/benefits_ai_platform/*.log
rag/benefits_ai_platform/uvicorn*.log

# Generated reports and figures
rag/benefits_ai_platform/reports/figures/*
rag/benefits_ai_platform/reports/*.html
rag/benefits_ai_platform/reports/*.pdf

# Keep reports folder structure
!rag/benefits_ai_platform/reports/figures/.gitkeep

# Streamlit secrets
rag/benefits_ai_platform/.streamlit/secrets.toml

# Temporary notebook exports
rag/benefits_ai_platform/*.nbconvert.ipynb
rag/benefits_ai_platform/notebooks/*.nbconvert.ipynb

# Test/cache files inside BenefitsAI
rag/benefits_ai_platform/.pytest_cache/
rag/benefits_ai_platform/.ruff_cache/
rag/benefits_ai_platform/.mypy_cache/
rag/benefits_ai_platform/htmlcov/
rag/benefits_ai_platform/.coverage

# Docker build archives
rag/benefits_ai_platform/*.tar
rag/benefits_ai_platform/*.tar.gz